#!/usr/bin/env python3
"""Refresh Herdr's host palette from its own WezTerm pane, without sending keys."""

import json
import os
import re
import stat
import subprocess
import sys
import time


def main():
    if os.environ.get("HERDR_ENV") != "1" or os.environ.get("TERM_PROGRAM") != "WezTerm":
        return
    pane_id = os.environ.get("WEZTERM_PANE", "")
    if not pane_id.isdecimal():
        return
    panes = json.loads(subprocess.check_output(
        ["wezterm", "cli", "list", "--format", "json"], timeout=2,
    ))
    pane = next((p for p in panes if str(p["pane_id"]) == pane_id), None)
    if pane is None:
        return
    tty_path = pane.get("tty_name", "")
    if not re.fullmatch(r"/dev/ttys[0-9]+", tty_path):
        return
    fd = os.open(tty_path, os.O_WRONLY | os.O_NOCTTY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if not stat.S_ISCHR(info.st_mode) or info.st_uid != os.getuid():
            return
        # Ask the real terminal. Herdr consumes these protocol replies and updates
        # every child pane's OSC 10/11 answers. No synthetic colors or key input.
        os.write(fd, b"\x1b]10;?\x1b\\\x1b]11;?\x1b\\")
    finally:
        os.close(fd)
    # Allow the host reply to reach Herdr before Codex's one-shot startup probe.
    time.sleep(0.1)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        if "--verbose" in sys.argv:
            print(f"herdr-refresh-colors: {error}", file=sys.stderr)
