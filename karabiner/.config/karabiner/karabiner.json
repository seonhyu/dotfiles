                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "caps_lock" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Left Control → Hyper (⌃⌥⌘)",
                        "manipulators": [
